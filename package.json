{
  "name": "honeycomb",
  "description": "All-in-one task starter app with jsPsych + React + Electron",
  "author": {
    "name": "Brown CCV",
    "email": "ccv-bot@brown.edu",
    "url": "https://ccv.brown.edu"
  },
  "honeycombVersion": "",
  "version": "3.4.1",
  "repository": "https://github.com/brown-ccv/honeycomb",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "dependencies": {
    "@serialport/binding-mock": "^10.2.2",
    "@serialport/stream": "^13.0.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "lodash": "^4.17.19",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.24.8",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@inquirer/prompts": "^8.7.3",
    "@jspsych/plugin-audio-keyboard-response": "^1.1.3",
    "@jspsych/plugin-call-function": "^1.1.3",
    "@jspsych/plugin-fullscreen": "^1.2.1",
    "@jspsych/plugin-html-button-response": "^1.2.0",
    "@jspsych/plugin-html-keyboard-response": "^1.1.3",
    "@jspsych/plugin-image-keyboard-response": "^1.1.3",
    "@jspsych/plugin-initialize-camera": "^1.0.2",
    "@jspsych/plugin-instructions": "^1.1.4",
    "@jspsych/plugin-preload": "^1.1.3",
    "@jspsych/plugin-survey": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "bootstrap": "^5.3.8",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "execa": "^10.1.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jspsych": "^7.3.4",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "start": "vite",
    "start:electron": "wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=\"http://localhost:5173\" electron .",
    "dev": "run-p --race start start:electron",
    "dev:home": "run-p --race \"start -- --mode home\" start:electron",
    "dev:home:video": "cross-env VITE_VIDEO=true npm run dev:home",
    "dev:clinic": "run-p --race \"start -- --mode clinic\" start:electron",
    "dev:clinic:video": "cross-env VITE_VIDEO=true npm run dev:clinic",
    "dev:firebase": "vite --mode firebase",
    "firebase:emulators:start": "firebase emulators:start --import emulator_data",
    "firebase:emulators:save": "firebase emulators:export emulator_data",
    "build": "vite build",
    "build:home": "vite build --mode home",
    "build:clinic": "vite build --mode clinic",
    "build:firebase": "vite build --mode firebase",
    "build:home:video": "cross-env VITE_VIDEO=true vite build --mode home",
    "build:clinic:video": "cross-env VITE_VIDEO=true vite build --mode clinic",
    "preview": "vite preview",
    "package": "electron-forge make",
    "package:windows": "npm run package -- --arch x64 --targets @electron-forge/maker-squirrel",
    "package:linux": "npm run package -- --arch x64 --targets @electron-forge/maker-deb",
    "package:mac": "npm run package -- --arch universal --targets @electron-forge/maker-dmg",
    "cli": "node cli.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "postinstall": "node version.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ],
    "**/*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "electron-winstaller": true,
    "protobufjs": true,
    "re2": true,
    "@firebase/util": true,
    "@serialport/bindings-cpp": true,
    "unrs-resolver": true
  }
}
